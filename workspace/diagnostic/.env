# Configuration propre au projet "diagnostic".
#
# Ces valeurs s'ajoutent a celles de credentials.env et les remplacent en cas
# de doublon. Elles ne concernent que ce projet : un autre projet garde les
# siennes.
#
# Lecture : codelab.lire("CLE", dossier=__file__) -- voir /workspace/README.md
#
# Ce fichier vit dans /workspace, qui n'est pas chiffre : n'y mets pas un
# secret que tu ne veux pas voir en clair sur le disque, et ne le versionne
# pas si tu pousses ce projet sur git.

# Schema Postgres du projet. Toutes ses tables y sont rangees, a l'ecart de
# celles des autres projets et du schema "dagster".
CODELAB_SCHEMA=diagnostic

# Adresse publique de l'interface Dagster, pour que les mails d'alerte
# contiennent un lien cliquable vers le run. Mets ici l'IP de ton ZimaOS.
CODELAB_DAGSTER_URL=http://<IP-ZimaOS>:3000
