{
  // Taches CodeLab.
  //
  // La premiere est declaree comme tache de BUILD PAR DEFAUT : elle se lance
  // avec Ctrl+Maj+B (Cmd+Maj+B sur Mac), sans passer par aucun menu. C'est le
  // seul raccourci clavier qu'un dossier de travail peut reserver -- VS Code
  // ne lit les raccourcis personnalises que dans le fichier de l'utilisateur,
  // jamais dans un .vscode partage. Pour en dedier un autre, voir le README,
  // section « Developper et deployer ».
  //
  // Chaque tache appelle l'outil "codelab" du conteneur, jamais une suite
  // d'instructions recopiee ici : la logique reste dans l'image, versionnee
  // et testee, et ce fichier ne devient pas un second endroit ou la meme
  // chose est ecrite differemment.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CodeLab : nouveau projet",
      "detail": "codelab create — dossier, git, AGENTS.md + CLAUDE.md, modules, base ; puis la fenetre se rouvre sur le projet (Ctrl+Maj+B)",
      "type": "shell",
      "command": "codelab create '${input:projet}' --ouvrir",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "CodeLab : nouveau projet sans base de donnees",
      "detail": "Comme ci-dessus, sans la base (codelab update la creera plus tard)",
      "type": "shell",
      "command": "codelab create '${input:projet}' --sans-db --ouvrir",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "CodeLab : mettre a jour un projet",
      "detail": "codelab update — manuel de l'agent, CLAUDE.md, modules, .gitignore, base ; rien de ce que le projet a ecrit n'est efface",
      "type": "shell",
      "command": "codelab update '${input:projet}'",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "CodeLab : mettre a jour tous les projets",
      "detail": "codelab update --tous — a lancer apres chaque mise a jour de CodeLab",
      "type": "shell",
      "command": "codelab update --tous",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "CodeLab : aide",
      "detail": "codelab help — toutes les commandes, en francais puis en anglais",
      "type": "shell",
      "command": "codelab help",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "projet",
      "type": "promptString",
      "description": "Nom du projet (lettres, chiffres, tirets — il sert aussi de nom de base)"
    }
  ]
}
