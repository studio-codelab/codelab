{
  // Taches CodeLab.
  //
  // La premiere est declaree comme tache de BUILD PAR DEFAUT : elle se lance
  // avec Ctrl+Maj+B (Cmd+Maj+B sur Mac), sans passer par aucun menu. C'est le
  // seul raccourci clavier qu'un dossier de travail peut reserver -- VS Code
  // ne lit les raccourcis personnalises que dans le fichier de l'utilisateur,
  // jamais dans un .vscode partage. Pour en dedier un autre, voir DEVELOPPER.md.
  //
  // Chaque tache appelle l'outil "codelab" du conteneur, jamais une suite
  // d'instructions recopiee ici : la logique reste dans l'image, versionnee
  // et testee, et ce fichier ne devient pas un second endroit ou la meme
  // chose est ecrite differemment.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CodeLab : nouveau projet",
      "detail": "Dossier, depot git, .gitignore et AGENTS.md — Ctrl+Maj+B",
      "type": "shell",
      "command": "codelab new '${input:projet}'",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "CodeLab : nouveau projet + base de donnees",
      "detail": "Comme ci-dessus, avec la base du projet et son schema dagster",
      "type": "shell",
      "command": "codelab new '${input:projet}' --db",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "CodeLab : creer la base d'un projet existant",
      "detail": "codelab db — base, schema et search_path (sans effet si elle existe deja)",
      "type": "shell",
      "command": "codelab db '${input:projet}'",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "CodeLab : mettre a jour le manuel de l'agent",
      "detail": "Rafraichit le bloc CodeLab du AGENTS.md ; ce qui est ecrit autour est conserve",
      "type": "shell",
      "command": "codelab agents '${input:projet}'",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "projet",
      "type": "promptString",
      "description": "Nom du projet (lettres, chiffres, tirets — il sert aussi de nom de base)"
    }
  ]
}
