#!/bin/sh
# sauvegarde -- sauvegarde chiffree de CodeLab, a lancer SUR L'HOTE.
#
#   sauvegarde creer [dossier]     ecrit une archive chiffree
#   sauvegarde verifier <archive>  restaure a blanc et controle
#   sauvegarde restaurer <archive> remet en place (demande confirmation)
#
# POURQUOI CHIFFREE, ET PAS SEULEMENT COPIEE.
#
# Une sauvegarde de CodeLab contient credentials.env : le mot de passe
# Postgres, celui du panneau, la cle de signature des sessions et le secret du
# second facteur. Elle contient aussi les cles hote SSH et le fichier des
# comptes. En clair sur un disque externe ou chez un hebergeur, elle vaut la
# machine entiere -- c'est meme plus simple a voler que la machine.
#
# openssl et rien d'autre : il est present partout, y compris sur un NAS
# minimal. Pas de gpg (trousseau a gerer), pas d'age (a installer).
#
# CE QUI EST SAUVEGARDE, et pourquoi c'est tout ce qu'il faut :
#
#   config/       les secrets et les cles SSH -- irremplacables
#   app-manager/  comptes, cles d'acces, registre des applications, journal
#   dagster/      l'etat de l'orchestrateur
#   workspace/    ton code
#   bases         toutes les bases, dans un seul dump SQL
#
# Ce qui n'y est PAS : les images Docker (elles se retelechargent) et les
# node_modules (ils se reinstallent). Une sauvegarde qu'on n'a pas envie de
# lancer parce qu'elle est trop grosse ne sert a rien.
set -eu

DONNEES="${CODELAB_DATA:-/DATA/AppData/codelab}"
CONTENEUR_PG="${CODELAB_PG_CONTAINER:-codelab-postgres}"
# Surchargeable pour les tests : la commande qui produit le dump SQL.
PGDUMP="${CODELAB_PGDUMP:-docker exec $CONTENEUR_PG pg_dumpall -U codelab}"

usage() {
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' >&2
}

# La phrase de passe ne passe JAMAIS par la ligne de commande : elle serait
# lisible dans "ps" par n'importe qui sur la machine, et resterait dans
# l'historique du shell. Variable d'environnement ou saisie interactive.
lire_phrase() {
  if [ -n "${CODELAB_PASSPHRASE:-}" ]; then
    printf '%s' "$CODELAB_PASSPHRASE"
    return
  fi
  printf 'Phrase de passe : ' >&2
  stty -echo 2>/dev/null || true
  read -r phrase
  stty echo 2>/dev/null || true
  printf '\n' >&2
  [ -n "$phrase" ] || { echo "sauvegarde: phrase vide." >&2; exit 2; }
  printf '%s' "$phrase"
}

chiffrer() {
  # -pbkdf2 et -iter : sans eux, openssl derive la cle en un seul tour de
  # MD5, et une phrase de passe courte se casse hors ligne en quelques
  # minutes. Avec, il faut y passer des annees.
  openssl enc -aes-256-cbc -pbkdf2 -iter 600000 -salt -pass fd:3
}
dechiffrer() {
  openssl enc -d -aes-256-cbc -pbkdf2 -iter 600000 -pass fd:3
}

cmd_creer() {
  dest="${1:-$PWD}"
  [ -d "$dest" ] || { echo "sauvegarde: $dest n'existe pas." >&2; exit 2; }
  [ -d "$DONNEES" ] || { echo "sauvegarde: $DONNEES introuvable (CODELAB_DATA ?)." >&2; exit 2; }

  horodatage=$(date -u +%Y%m%d-%H%M%S)
  archive="$dest/codelab-$horodatage.tar.gz.enc"
  travail=$(mktemp -d)
  # Le dossier de travail contient les secrets en clair le temps de
  # l'archivage : il n'est lisible que par son proprietaire, et il part
  # quoi qu'il arrive -- y compris si le dump echoue.
  chmod 700 "$travail"
  trap 'rm -rf "$travail"' EXIT INT TERM

  echo "[1/3] bases de donnees..." >&2
  if ! $PGDUMP > "$travail/bases.sql" 2>"$travail/pg.err"; then
    echo "sauvegarde: le dump a echoue :" >&2
    sed 's/^/  /' "$travail/pg.err" >&2
    exit 1
  fi
  echo "      $(wc -c < "$travail/bases.sql") octets" >&2

  echo "[2/3] fichiers..." >&2
  # Les chemins absents ne font pas echouer : une installation peut ne pas
  # avoir encore de dossier dagster.
  presents=""
  for d in config app-manager dagster workspace; do
    [ -e "$DONNEES/$d" ] && presents="$presents $d"
  done
  [ -n "$presents" ] || { echo "sauvegarde: rien a sauvegarder dans $DONNEES." >&2; exit 1; }

  echo "[3/3] chiffrement..." >&2
  phrase=$(lire_phrase)
  # La phrase passe par un descripteur de fichier, jamais par argv.
  # shellcheck disable=SC2086
  tar -C "$DONNEES" -czf - $presents -C "$travail" bases.sql \
    | chiffrer 3<<EOF2 > "$archive"
$phrase
EOF2
  chmod 600 "$archive"
  echo "" >&2
  echo "archive : $archive" >&2
  echo "taille  : $(wc -c < "$archive") octets" >&2
  echo "" >&2
  echo "Verifie-la MAINTENANT, pas le jour ou tu en auras besoin :" >&2
  echo "  sauvegarde verifier $archive" >&2
}

cmd_verifier() {
  archive="${1:?usage: sauvegarde verifier <archive>}"
  [ -r "$archive" ] || { echo "sauvegarde: $archive illisible." >&2; exit 2; }
  travail=$(mktemp -d); chmod 700 "$travail"
  trap 'rm -rf "$travail"' EXIT INT TERM
  # Le contenu est extrait dans un sous-dossier : les fichiers de travail
  # (journal d'erreurs) ne doivent pas se melanger a ce qu'on liste ensuite.
  sortie="$travail/contenu"; mkdir -p "$sortie"
  phrase=$(lire_phrase)

  # Une sauvegarde jamais restauree n'est pas une sauvegarde. Cette commande
  # fait la restauration pour de vrai, dans un dossier jetable, et controle
  # que ce qui compte est bien la.
  #
  # Les messages d'openssl et de tar sont mis de cote : ils parlent de
  # "bad decrypt" et de blocs illisibles, ce qui ne dit pas a l'utilisateur
  # ce qu'il doit faire. On les garde pour le cas ou on en aurait besoin, et
  # on affiche une phrase utile a la place.
  if ! dechiffrer 3<<EOF2 < "$archive" 2>"$travail/openssl.err" \
       | tar -C "$sortie" -xzf - 2>"$travail/tar.err"
$phrase
EOF2
  then
    echo "ECHEC : l'archive ne s'ouvre pas." >&2
    echo "  Cause la plus probable : phrase de passe erronee." >&2
    echo "  Sinon, le fichier est abime -- verifie une autre copie." >&2
    exit 1
  fi

  manques=""
  for attendu in bases.sql config/credentials.env; do
    [ -e "$sortie/$attendu" ] || manques="$manques $attendu"
  done
  if [ -n "$manques" ]; then
    echo "ECHEC : l'archive s'ouvre mais il manque :$manques" >&2
    exit 1
  fi
  # Le dump doit contenir du SQL, pas un message d'erreur de trois lignes.
  if ! grep -q 'PostgreSQL database' "$sortie/bases.sql" 2>/dev/null; then
    echo "ECHEC : bases.sql ne ressemble pas a un dump PostgreSQL." >&2
    exit 1
  fi
  echo "OK -- archive dechiffree et complete." >&2
  echo "  dump     : $(wc -l < "$sortie/bases.sql") lignes" >&2
  echo "  contenu  : $(ls "$sortie" | tr '\n' ' ')" >&2
}

cmd_restaurer() {
  archive="${1:?usage: sauvegarde restaurer <archive>}"
  [ -r "$archive" ] || { echo "sauvegarde: $archive illisible." >&2; exit 2; }
  echo "Cette commande ECRASE $DONNEES avec le contenu de l'archive." >&2
  echo "Arrete la stack d'abord :  docker compose down" >&2
  printf 'Taper « restaurer » pour confirmer : ' >&2
  read -r reponse
  [ "$reponse" = "restaurer" ] || { echo "annule." >&2; exit 1; }

  travail=$(mktemp -d); chmod 700 "$travail"
  trap 'rm -rf "$travail"' EXIT INT TERM
  phrase=$(lire_phrase)
  dechiffrer 3<<EOF2 < "$archive" | tar -C "$travail" -xzf -
$phrase
EOF2
  mkdir -p "$DONNEES"
  for d in config app-manager dagster workspace; do
    [ -e "$travail/$d" ] || continue
    rm -rf "$DONNEES/$d"
    cp -a "$travail/$d" "$DONNEES/$d"
    echo "  $d restaure" >&2
  done
  echo "" >&2
  echo "Fichiers en place. Les bases se rechargent ensuite :" >&2
  echo "  docker compose up -d codelab-postgres" >&2
  echo "  docker exec -i $CONTENEUR_PG psql -U codelab -d postgres < $travail/bases.sql" >&2
  echo "" >&2
  echo "Le dump reste ici tant que ce terminal est ouvert : $travail/bases.sql" >&2
  # On garde le dump : le trap l'effacerait avant que l'utilisateur ait pu
  # le charger.
  trap - EXIT INT TERM
}

case "${1:-}" in
  creer)     shift; cmd_creer "$@" ;;
  verifier)  shift; cmd_verifier "$@" ;;
  restaurer) shift; cmd_restaurer "$@" ;;
  -h|--help|help|"") usage; [ "${1:-}" = "" ] && exit 2 || exit 0 ;;
  *) echo "sauvegarde: commande inconnue \"$1\"." >&2; usage; exit 2 ;;
esac
