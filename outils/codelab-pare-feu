#!/bin/sh
# codelab-pare-feu -- limite les ports de CodeLab au reseau local. SUR L'HOTE.
#
#   codelab-pare-feu poser 192.168.1.0/24
#   codelab-pare-feu verifier
#   codelab-pare-feu retirer
#
# LE PIEGE QU'IL FAUT CONNAITRE AVANT DE LIRE LA SUITE.
#
# Les ports publies par Docker NE PASSENT PAS par la chaine INPUT. Docker
# installe ses propres regles de redirection (nat/PREROUTING) et le trafic
# traverse ensuite FORWARD, pas INPUT. Un pare-feu ecrit "comme d'habitude" --
# ufw, une regle INPUT, nft sur le hook input -- ne filtre donc RIEN de
# CodeLab, tout en donnant l'impression du contraire. C'est le genre de
# protection qui rassure sans proteger.
#
# Le bon endroit est la chaine DOCKER-USER : Docker la cree, la traverse
# AVANT ses propres regles, et ne l'ecrase jamais. C'est le seul point ou
# l'on peut filtrer un port publie sans se battre avec Docker a chaque
# redemarrage.
#
# CE QUE CE SCRIPT NE TOUCHE PAS : le port 22 de l'hote. Il ne passe pas par
# Docker, donc pas par DOCKER-USER -- et surtout, une erreur dessus
# t'enfermerait dehors. Si tu veux le restreindre aussi, fais-le a la main,
# avec une session ouverte a cote.
set -eu

PORTS="${CODELAB_PORTS:-2222,3000,9001,9002}"
MARQUE="codelab"

usage() { sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' >&2; }

exige_root() {
  [ "$(id -u)" -eq 0 ] || { echo "codelab-pare-feu: a lancer en root." >&2; exit 2; }
}

exige_docker_user() {
  if ! iptables -S DOCKER-USER >/dev/null 2>&1; then
    echo "codelab-pare-feu: la chaine DOCKER-USER n'existe pas." >&2
    echo "  Docker n'est pas demarre, ou il ne gere pas iptables" >&2
    echo "  (option \"iptables\": false dans /etc/docker/daemon.json)." >&2
    echo "  Sans elle, ce script ne peut rien filtrer -- et une regle INPUT" >&2
    echo "  ne servirait a rien : les ports publies ne la traversent pas." >&2
    exit 1
  fi
}

# Nos regles se reconnaissent a leur commentaire : on peut les retirer sans
# toucher a celles de Docker ni a celles de quelqu'un d'autre.
#
# Le motif ne met PAS de guillemets autour du commentaire : "iptables -S" n'en
# ajoute que si le commentaire contient une espace. Avec des guillemets, le
# motif ne trouvait jamais rien -- et les trois commandes echouaient en
# silence : la pose s'empilait, "verifier" annoncait qu'il n'y avait rien, et
# "retirer" ne retirait rien.
motif_des_notres() {
  iptables -S DOCKER-USER 2>/dev/null | grep -- "--comment $MARQUE\( \|$\)"
}

retirer_les_notres() {
  # On boucle : iptables renumerote apres chaque suppression.
  while regle=$(motif_des_notres | head -1) && [ -n "$regle" ]; do
    # shellcheck disable=SC2086
    set -- $(echo "$regle" | sed 's/^-A /-D /')
    iptables "$@" 2>/dev/null || break
  done
}

cmd_poser() {
  reseau="${1:?usage: codelab-pare-feu poser <reseau>, ex 192.168.1.0/24}"
  exige_root; exige_docker_user
  case "$reseau" in
    */*) : ;;
    *) echo "codelab-pare-feu: donne un reseau avec son masque, ex 192.168.1.0/24" >&2; exit 2 ;;
  esac

  retirer_les_notres
  # -I et non -A : la regle doit passer AVANT le "RETURN" que Docker place
  # au bout de DOCKER-USER, sinon elle n'est jamais atteinte.
  #
  # On autorise d'abord le reseau local, puis on jette le reste. Deux regles
  # plutot qu'une negation : la lecture de "iptables -S" reste evidente six
  # mois plus tard, et l'ordre est explicite.
  iptables -I DOCKER-USER 1 -p tcp -m multiport --dports "$PORTS" \
           ! -s "$reseau" -j DROP -m comment --comment "$MARQUE"
  iptables -I DOCKER-USER 1 -p tcp -m multiport --dports "$PORTS" \
           -s "$reseau" -j RETURN -m comment --comment "$MARQUE"
  echo "Pose. Ports $PORTS joignables depuis $reseau seulement." >&2
  echo "" >&2
  echo "Ces regles ne survivent PAS a un redemarrage de l'hote." >&2
  echo "Pour les rendre permanentes, selon ta distribution :" >&2
  echo "  apt install iptables-persistent   # puis  netfilter-persistent save" >&2
  echo "  ou une unite systemd qui rejoue :  codelab-pare-feu poser $reseau" >&2
  echo "" >&2
  echo "Verifie DEPUIS UNE AUTRE MACHINE que le panneau repond encore." >&2
}

cmd_verifier() {
  exige_docker_user
  nos_regles=$(motif_des_notres || true)
  if [ -z "$nos_regles" ]; then
    echo "Aucune regle CodeLab dans DOCKER-USER." >&2
    echo "Les ports $PORTS sont joignables depuis n'importe quelle interface." >&2
    exit 1
  fi
  echo "Regles en place :" >&2
  echo "$nos_regles" | sed 's/^/  /' >&2
  echo "" >&2
  echo "Rappel : ceci ne filtre QUE les ports publies par Docker." >&2
  echo "Le port 22 de l'hote n'est pas concerne." >&2
}

cmd_retirer() {
  exige_root; exige_docker_user
  retirer_les_notres
  echo "Regles CodeLab retirees. Les ports redeviennent joignables de partout." >&2
}

case "${1:-}" in
  poser)    shift; cmd_poser "$@" ;;
  verifier) shift; cmd_verifier "$@" ;;
  retirer)  shift; cmd_retirer "$@" ;;
  -h|--help|help|"") usage; [ "${1:-}" = "" ] && exit 2 || exit 0 ;;
  *) echo "codelab-pare-feu: commande inconnue \"$1\"." >&2; usage; exit 2 ;;
esac
