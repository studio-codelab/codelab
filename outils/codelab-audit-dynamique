#!/usr/bin/env python3
"""codelab-audit-dynamique -- sonde une instance CodeLab EN MARCHE.

    ./codelab-audit-dynamique http://192.168.1.20:9001 [--apps 9002]

Un audit statique lit le code ; celui-ci parle a la machine. C'est la
difference qui compte : la moitie des trous ne sont pas dans le code mais
dans la configuration reelle -- une variable oubliee, un port publie par
erreur, une garde active en developpement et pas en service.

A lancer APRES chaque mise en service, et apres tout changement de reverse
proxy. Ne remplace pas un pentest par un humain : il verifie ce qu'on sait
deja devoir verifier, pas ce a quoi personne n'a pense.

Il ne casse rien : que des lectures et des ecritures qui doivent etre
REFUSEES. Si l'une passe, c'est justement le probleme.

Sortie 0 si tout va bien, 1 s'il reste un point rouge.
"""
import argparse
import http.cookiejar
import json
import re
import sys
import urllib.error
import urllib.parse
import urllib.request

VERT, ROUGE, JAUNE, FIN = "\033[32m", "\033[31m", "\033[33m", "\033[0m"

resultats = []


def note(gravite, titre, ok, detail=""):
    resultats.append((gravite, titre, ok, detail))
    couleur = VERT if ok else (ROUGE if gravite == "haute" else JAUNE)
    marque = "OK  " if ok else ("!!  " if gravite == "haute" else "..  ")
    print(f"{couleur}{marque}{FIN}{titre}")
    if detail:
        print(f"      {detail}")


def demander(url, methode="GET", donnees=None, entetes=None, opener=None,
             suivre=True):
    """Une requete, sans jamais lever : un audit qui s'arrete au premier
    refus n'auditerait rien."""
    req = urllib.request.Request(url, data=donnees, method=methode)
    for c, v in (entetes or {}).items():
        req.add_header(c, v)
    ouvre = (opener or urllib.request.build_opener()).open
    try:
        r = ouvre(req, timeout=10)
        return r.getcode(), dict(r.headers), r.read(200000)
    except urllib.error.HTTPError as e:
        return e.code, dict(e.headers), e.read(200000)
    except Exception as e:                                    # noqa: BLE001
        return None, {}, str(e).encode()


def biscuit_secure_sans_https(pot, base):
    """Le cas qui fait mentir un audit : cookie Secure, adresse en clair."""
    return (not base.startswith("https://")
            and any(c.secure for c in pot))


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("base", help="adresse du panneau, ex http://192.168.1.20:9001")
    ap.add_argument("--apps", type=int, default=9002,
                    help="port des applications (0 pour ne pas le sonder)")
    ap.add_argument("--mot-de-passe", default=None,
                    help="mot de passe admin : debloque les controles qui "
                         "demandent une session")
    a = ap.parse_args()
    base = a.base.rstrip("/")
    hote = urllib.parse.urlparse(base).hostname

    print(f"\n--- CodeLab, audit dynamique de {base} ---\n")

    # 1. Ce qui doit etre ferme sans session.
    print("Acces sans authentification")
    ouvertes = []
    for chemin in ("/api/apps", "/api/utilisateurs", "/api/securite",
                   "/api/activite", "/api/mon-compte", "/api/categories",
                   "/api/browse?path=/", "/api/inscription"):
        code, _, _ = demander(base + chemin)
        # /api/inscription est public a dessein : la page de connexion doit
        # savoir s'il faut afficher « Creer un compte ».
        attendu_public = chemin == "/api/inscription"
        if code == 200 and not attendu_public:
            ouvertes.append(f"{chemin} -> 200")
    note("haute", "Les API d'administration exigent une session",
         not ouvertes, "; ".join(ouvertes))

    # 2. Le transport.
    print("\nTransport et cookie")
    code, entetes, corps = demander(base + "/login")
    en_https = base.startswith("https://")
    note("haute", "Connexion chiffree (HTTPS)", en_https,
         "" if en_https else "le mot de passe et le cookie passent en clair")
    serveur = entetes.get("Server", "")
    note("basse", "L'en-tete Server ne donne pas de version",
         not re.search(r"\d+\.\d+", serveur), f"Server: {serveur}")

    # 3. Le cookie de session, tel qu'il est REELLEMENT pose.
    pot = http.cookiejar.CookieJar()
    opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(pot))
    mdp = a.mot_de_passe
    connecte = False
    if mdp:
        code, entetes, corps = demander(
            base + "/login", "POST", json.dumps({"password": mdp}).encode(),
            {"Content-Type": "application/json"}, opener)
        connecte = code == 200
        note("haute", "Connexion avec le mot de passe fourni", connecte,
             "" if connecte else f"statut {code} -- les controles suivants sont sautes")

        # La connexion peut REUSSIR sans que la session soit portee ensuite :
        # un cookie Secure n'est pas renvoye sur une adresse en http. Sans ce
        # controle, tout ce qui suit repond 401 -- et les tests qui attendent
        # un refus passent au vert pour la mauvaise raison. C'est exactement
        # ce qui s'est produit au premier essai de cet outil.
        if connecte:
            code, _, _ = demander(base + "/api/apps", opener=opener)
            if code != 200:
                connecte = False
                secure = biscuit_secure_sans_https(pot, base)
                note("haute", "La session est bien portee apres connexion", False,
                     ("le cookie est marque Secure et l'adresse est en http : "
                      "il n'est pas renvoye. Sonde l'instance en https, ou "
                      "retire APP_MANAGER_HTTPS pour auditer en local."
                      if secure else f"/api/apps repond {code} avec le cookie"))

    biscuit = next((c for c in pot if c.name in ("session", "codelab_session")), None)
    if biscuit:
        httponly = "httponly" in {k.lower() for k in (biscuit._rest or {})}
        note("haute", "Cookie de session en HttpOnly", httponly,
             "" if httponly else "un script peut le lire")
        note("haute" if en_https else "basse", "Cookie de session en Secure",
             bool(biscuit.secure),
             "" if biscuit.secure else "le navigateur l'enverrait en clair")
        ss = (biscuit._rest or {}).get("SameSite", "")
        note("moyenne", "Cookie de session en SameSite", bool(ss), f"SameSite={ss or 'absent'}")
    elif mdp:
        note("moyenne", "Cookie de session trouve", False, "aucun cookie pose")

    # 4. Le jeton : une ecriture avec le cookie mais sans le jeton.
    if connecte:
        print("\nJeton sur les ecritures")
        code, _, _ = demander(base + "/api/categories", "PUT",
                              b'{"categories":["audit"]}',
                              {"Content-Type": "application/json"}, opener)
        if code == 401:
            note("moyenne", "Une ecriture sans jeton est refusee", False,
                 "non concluant : la session n'est pas portee (statut 401), "
                 "le jeton n'a donc pas ete mis a l'epreuve")
        else:
            note("haute", "Une ecriture sans jeton est refusee", code == 403,
                 f"statut {code}" + ("" if code == 403 else
                                     " -- une autre origine peut piloter le panneau"))

        # 5. Le bornage des chemins.
        print("\nBornage des chemins")
        fuites = []
        for tentative in ("/etc", "/", "../../etc", "/workspace/../../etc"):
            code, _, corps = demander(
                base + "/api/browse?path=" + urllib.parse.quote(tentative),
                opener=opener)
            texte = corps.decode("utf-8", "replace")
            if code == 200 and ("passwd" in texte or '"shadow"' in texte):
                fuites.append(tentative)
        note("haute", "L'explorateur ne sort pas du workspace", not fuites,
             "; ".join(fuites))

    # 6. La separation des origines.
    if a.apps:
        print("\nOrigine des applications")
        origine_apps = f"{urllib.parse.urlparse(base).scheme}://{hote}:{a.apps}"
        code_sante, _, _ = demander(origine_apps + "/health")
        if code_sante is None:
            note("haute", "Les applications ont leur propre origine", False,
                 f"{origine_apps} ne repond pas : les applications sont servies "
                 f"par le panneau, donc dans SON origine")
        else:
            fuites = []
            for chemin in ("/", "/login", "/api/apps", "/api/utilisateurs"):
                code, _, _ = demander(origine_apps + chemin)
                if code == 200:
                    fuites.append(chemin)
            note("haute", "Le panneau ne repond pas sur l'origine des applications",
                 not fuites, "; ".join(f"{f} -> 200" for f in fuites))

    # 7. La limite de tentatives.
    #
    # EN DERNIER, et il faut le savoir : cette sonde epuise volontairement le
    # compteur d'essais. Pendant quelques minutes, les connexions depuis cette
    # adresse seront refusees -- y compris les tiennes, et y compris un second
    # passage de cet outil. C'est le prix d'un controle qui verifie vraiment.
    print("\nLimite de tentatives  (bloque les connexions quelques minutes)")
    codes = []
    for _ in range(12):
        code, _, _ = demander(base + "/login", "POST",
                              json.dumps({"password": "faux-mot-de-passe"}).encode(),
                              {"Content-Type": "application/json"})
        codes.append(code)
    note("moyenne", "Le mot de passe n'est pas essayable a l'infini",
         429 in codes, f"12 essais -> statuts {sorted(set(c for c in codes if c))}")

    # Bilan.
    rouges = [(g, t) for g, t, ok, _ in resultats if not ok and g == "haute"]
    autres = [(g, t) for g, t, ok, _ in resultats if not ok and g != "haute"]
    print("\n--- bilan ---")
    print(f"  {len(resultats) - len(rouges) - len(autres)} au vert, "
          f"{len(rouges)} en rouge, {len(autres)} a regarder")
    for _, t in rouges:
        print(f"  {ROUGE}rouge{FIN} : {t}")
    for _, t in autres:
        print(f"  {JAUNE}a voir{FIN} : {t}")
    return 1 if rouges else 0


if __name__ == "__main__":
    sys.exit(main())
