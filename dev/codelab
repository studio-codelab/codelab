#!/bin/sh
# codelab -- outil de projet du conteneur codelab-dev.
#
#   codelab create <nom>      cree un projet pret a travailler : dossier, git,
#                             .gitignore, README, AGENTS.md + CLAUDE.md, modules
#                             codelab_auth / codelab_web, base de donnees
#     ... --sans-db            sans la base (--no-db)
#     ... --ouvrir             et rouvre la fenetre VS Code dessus (--open)
#   codelab update [projet]   met un projet existant au niveau de la stack :
#                             manuel de l'agent, CLAUDE.md, modules, .gitignore,
#                             base -- sans toucher a ce que le projet a ecrit
#     ... --tous               tous les projets CodeLab de /workspace (--all)
#   codelab video [projet]    la video de presentation du projet (video/presentation.mp4)
#   codelab help [commande]   l'aide (en anglais)
#
#   Outils plus fins, appeles par les precedents : db <nom> (la base seule),
#   vscode-bases (les connexions SQLTools). Anciens noms, gardes pour les
#   taches VS Code et les habitudes deja prises : new = create, agents = le
#   manuel seul.
#
# Une seule commande pour tout ce qui touche a un projet, plutot qu'un
# executable par geste : la liste des sous-commandes se decouvre avec
# "codelab" seul, et il n'y a qu'un nom a retenir.
#
# Vecu : « mon agent Claude ne fonctionne pas de maniere continue sur
# l'app ». Les projets crees avant une mise a jour gardaient un vieux manuel,
# parfois sans CLAUDE.md : l'agent n'avait pas les consignes du jour. Deux
# gestes au lieu de cinq (new, db, agents, vscode-bases, copie des modules) :
# create au debut, update apres chaque mise a jour de la stack.
set -eu

MANUEL="${CODELAB_AGENTS_SOURCE:-/usr/local/share/codelab/AGENTS.md}"
# Les modules deposes dans chaque nouveau projet, en Python et en Node :
# « se connecter avec CodeLab » (codelab_auth), pour que l'identite soit
# prete des la premiere seconde, comme la base de donnees ; et les pages
# d'erreur et en-tetes de securite (codelab_web).
MODELES="${CODELAB_MODELES:-/usr/local/share/codelab/modeles}"
# Le marqueur garde son ancien texte (« codelab agents ») : les AGENTS.md
# deja poses le portent, et c'est lui qu'update cherche pour remplacer le bloc.
DEBUT='<!-- codelab:debut -- bloc gere par "codelab agents", ne pas editer a la main -->'
FIN='<!-- codelab:fin -->'

# ------------------------------- help -------------------------------
#
# L'aide, en anglais, sous une seule commande : « codelab help » (et
# « codelab help <commande> » : le detail). Vecu : « retire codelab aide, ne
# garde que codelab help », puis « garde que la version anglaise de codelab
# help ». Les messages des commandes, eux, restent en francais.
# La meme liste vit dans le hub (Applications > Commandes) et dans
# FONCTIONNALITES.md : un test verifie que chaque commande du dispatch y est.

aide() {
  case "${1:-}" in
    create|new) cat <<'HELP'
codelab create <name> [--no-db] [--open]

  Creates /workspace/<name>, ready to work on:
    - a git repository, a .gitignore (.env first) and a README.md;
    - AGENTS.md (the CodeLab manual, read by Codex) and CLAUDE.md (which
      imports it, for Claude Code);
    - codelab_auth.py / codelab-auth.js: sign in with CodeLab;
    - codelab_web.py / codelab-web.js: error pages and security headers;
    - the project database (same name), backed up every day.

  --no-db     no database (update or db can create it later)
  --open      reopen the VS Code window on the project
  (French spellings work too: --sans-db, --ouvrir)

  The name: letters, digits, dashes and underscores, starting with a
  letter. It is the folder, the address (/name/) and the database name.
HELP
    ;;
    update) cat <<'HELP'
codelab update [project] [--no-db]
codelab update --all

  Brings an existing project up to the current stack, deleting nothing:
    - rewrites the CodeLab block of AGENTS.md (the rest of the file stays);
    - adds CLAUDE.md if missing (an existing CLAUDE.md is left alone);
    - adds the missing codelab_auth / codelab_web modules, and updates the
      ones git keeps unchanged (a modified copy is left as it is);
    - adds .env and .dagster-venv/ to .gitignore if they are missing;
    - creates the project database if missing (--no-db to skip it).

  No argument: the project of the current folder. --all: every
  project in /workspace that already carries the CodeLab manual.
  Run it again after every CodeLab update.
HELP
    ;;
    video) cat <<'HELP'
codelab video [project]

  The project's presentation video, shown by the hub on its page.
  First run: writes video/scenario.mjs, to fill in (or to have your agent
             write: section 14 of the AGENTS.md manual).
  Then     : plays the scenario in Chromium, adds the French voice-over
             and produces video/presentation.mp4 and video/affiche.jpg.
HELP
    ;;
    db) cat <<'HELP'
codelab db <name>

  The database only: creates it with its account, its "dagster" schema and
  its search_path (no effect if it exists). create and update call it.
HELP
    ;;
    vscode-bases) cat <<'HELP'
codelab vscode-bases

  Declares every project database in SQLTools (VS Code), each with its own
  account. The workstation does it by itself every few minutes.
HELP
    ;;
    *) cat <<'HELP'
codelab -- the CodeLab project tool

  codelab create <name>     creates a complete project (git, agent manual,
                            CLAUDE.md, CodeLab modules, database)
      --no-db               without a database
      --open                reopens VS Code on the project
  codelab update [project]  updates an existing project (manual, CLAUDE.md,
                            modules, .gitignore, database), deleting nothing
      --all                 every CodeLab project in /workspace
  codelab video [project]   the project's presentation video
  codelab help [command]    this help

  Finer tools : codelab db <name> (the database only),
                codelab vscode-bases (SQLTools connections).
  Former names: new = create; agents = the manual only (update does more).

  Details of a command: codelab help create
HELP
    ;;
  esac
}

usage() { aide >&2; }

# --------------------------------- new ---------------------------------
#
# Tout ce qui est propre a CodeLab dans la creation d'un projet, en une
# commande : le dossier, le depot git, le .gitignore, et le AGENTS.md que
# l'agent lira. Volontairement PAS d'echafaudage de framework -- "npm create
# vite" telecharge, pose des questions et evolue a son rythme ; le reproduire
# ici vieillirait mal. La commande l'affiche en piste suivante, c'est tout.

# Rouvre la fenetre VS Code sur un dossier -- quand il y en a une.
#
# COMMENT CELA MARCHE. La fenetre VS Code qui tourne sur le poste de travail
# expose une socket a l'interieur du conteneur ; son chemin arrive dans
# VSCODE_IPC_HOOK_CLI. Le petit executable "code" pose par le serveur
# distant (son "remote-cli") parle a la fenetre a travers cette socket.
#
# Deux conditions, donc, et aucune n'est garantie : la variable, qui manque
# des qu'on est dans une session SSH ordinaire, et l'executable, dont le
# chemin contient l'empreinte de la version du serveur.
#
# RIEN ICI NE DOIT FAIRE ECHOUER LA COMMANDE. Le projet est deja cree quand
# on arrive : ouvrir la fenetre est un confort. Un echec se raconte, il ne
# se propage pas -- sinon "codelab create" sortirait en erreur sur un projet
# parfaitement valide, et la prochaine fois on ne saurait plus si le projet
# a ete cree ou non.
ouvrir_dans_vscode() {
  dossier="$1"

  if [ -z "${VSCODE_IPC_HOOK_CLI:-}" ]; then
    echo "[codelab]   aucune fenetre VS Code a rouvrir (session SSH simple)."
    return 0
  fi

  outil="$(command -v code 2>/dev/null || true)"
  if [ -z "$outil" ] || [ ! -x "$outil" ]; then
    # Le serveur distant s'installe sous un dossier portant l'empreinte de
    # sa version. On prend le plus recent plutot que d'en figer une : elle
    # change a chaque mise a jour de VS Code.
    outil=""
    for candidat in $(ls -1dt "$HOME"/.vscode-server/bin/*/bin/remote-cli/code 2>/dev/null); do
      if [ -x "$candidat" ]; then outil="$candidat"; break; fi
    done
  fi

  if [ -z "$outil" ]; then
    echo "[codelab]   VS Code est la, mais son outil \"code\" reste introuvable :"
    echo "[codelab]   ouvre le dossier a la main ($dossier)."
    return 0
  fi

  echo "[codelab]   ouverture de la fenetre sur $dossier"
  "$outil" --reuse-window "$dossier" || {
    echo "[codelab]   VS Code n'a pas repondu : ouvre le dossier a la main."
    return 0
  }
}


# Le nom d'un projet sert de dossier, d'adresse web sous le panneau et
# d'identifiant SQL : la meme regle partout, verifiee avant d'agir.
nom_valide() {
  case "$1" in
    *[!a-zA-Z0-9_-]* | "" | [!a-zA-Z]*) return 1 ;;
  esac
  return 0
}

# Les quatre modules CodeLab d'un projet. A la creation, on les copie. A la
# mise a jour (« maj »), on ajoute ceux qui manquent et on remplace ceux que
# git garde intacts -- l'ancienne version reste dans l'historique. Une copie
# modifiee ou non versionnee n'est jamais ecrasee : ce serait perdre le
# travail de quelqu'un sans retour possible.
deposer_modules() {
  dossier="$1"; mode="${2:-}"
  for modele in codelab_auth.py codelab-auth.js codelab_web.py codelab-web.js; do
    source_m="$MODELES/$modele"; cible="$dossier/$modele"
    [ -f "$source_m" ] || continue
    if [ ! -e "$cible" ]; then
      cp "$source_m" "$cible"
      [ -z "$mode" ] || echo "[codelab]   $modele ajoute."
    elif cmp -s "$source_m" "$cible"; then
      :
    elif git -C "$dossier" ls-files --error-unmatch "$modele" >/dev/null 2>&1 \
         && git -C "$dossier" diff --quiet HEAD -- "$modele" 2>/dev/null; then
      cp "$source_m" "$cible"
      echo "[codelab]   $modele mis a jour (l'ancienne version reste dans git)."
    else
      echo "[codelab]   $modele differe du modele et n'est pas intact dans git :" \
           "laisse tel quel (le modele : $source_m)."
    fi
  done
}

# Ce qu'un .gitignore de projet CodeLab doit au moins contenir. .env en
# tete : /workspace n'est pas chiffre, et un secret pousse sur un depot
# distant ne se rattrape pas. .dagster-venv/ : l'environnement que Dagster
# construit dans le projet. Le reste (dist/, build/...) depend du projet :
# update ne l'impose pas a un projet existant, qui versionne peut-etre dist/.
GITIGNORE_REQUIS=".env .dagster-venv/"

completer_gitignore() {
  fichier="$1/.gitignore"
  for motif in $GITIGNORE_REQUIS; do
    if [ ! -f "$fichier" ] || ! grep -qxF "$motif" "$fichier"; then
      # Une derniere ligne sans fin de ligne collerait le motif a elle.
      if [ -s "$fichier" ] && [ -n "$(tail -c 1 "$fichier")" ]; then echo >> "$fichier"; fi
      echo "$motif" >> "$fichier"
      echo "[codelab]   .gitignore : $motif ajoute."
    fi
  done
}

# La base du projet et ses connexions SQLTools. Un echec ici ne fait pas
# echouer create ni update : le projet est la, et la base se rattrape par
# « codelab update » quand Postgres repond. Le sous-shell est voulu :
# cmd_db sort par exit, qui arreterait sinon tout le script.
assurer_la_base() {
  if ( cmd_db "$1" ); then
    ( cmd_vscode_bases --discret ) >/dev/null 2>&1 || true
  else
    echo "[codelab]   base \"$1\" non creee -- relance « codelab update » plus tard."
  fi
}

cmd_create() {
  projet=""
  avec_db=1
  ouvrir=0
  for arg in "$@"; do
    case "$arg" in
      --sans-db|--no-db) avec_db=0 ;;
      # --db : l'ancien drapeau de « codelab new », la base etant desormais
      # creee par defaut. Garde pour les taches VS Code deja copiees.
      --db) avec_db=1 ;;
      --ouvrir|--open) ouvrir=1 ;;
      -*)   echo "codelab create: option inconnue \"$arg\"." >&2; exit 2 ;;
      *)    [ -z "$projet" ] || { usage; exit 2; }; projet="$arg" ;;
    esac
  done
  [ -n "$projet" ] || { usage; exit 2; }

  nom_valide "$projet" || {
    echo "codelab create: nom invalide \"$projet\" -- lettres, chiffres," \
         "tirets et soulignes, en commencant par une lettre." >&2
    exit 2
  }

  RACINE="${CODELAB_WORKSPACE:-/workspace}"
  DOSSIER="$RACINE/$projet"
  # Jamais par-dessus un dossier existant : la commande doit rester sans
  # danger a lancer deux fois par erreur. Un projet existant se met a jour.
  [ ! -e "$DOSSIER" ] || {
    echo "codelab create: $DOSSIER existe deja -- pour le mettre a jour :" \
         "codelab update $projet" >&2
    exit 1
  }

  mkdir -p "$DOSSIER"
  cd "$DOSSIER"

  git init -q 2>/dev/null || echo "[codelab] git indisponible : depot non initialise."

  cat > .gitignore <<'IGNORE'
.env
node_modules/
vendor/
.dagster-venv/
dist/
build/
__pycache__/
IGNORE

  cat > README.md <<README
# $projet

*A completer : ce que fait ce projet, et comment le lancer.*
README

  cmd_agents "$DOSSIER" >/dev/null
  deposer_modules "$DOSSIER"
  # Un "[ ... ] && cmd" ici sortirait du script sous "set -e" quand le test
  # echoue : la forme longue evite ce piege classique.
  if [ "$avec_db" -eq 1 ]; then
    assurer_la_base "$projet"
  fi

  echo "[codelab] projet cree : $DOSSIER"
  echo "[codelab]   AGENTS.md + CLAUDE.md poses -- complete la section \"Projet $projet\""
  echo "[codelab]   connexion CodeLab : codelab_auth.py / codelab-auth.js (voir leur en-tete)"
  echo "[codelab]   erreurs et en-tetes : codelab_web.py / codelab-web.js"
  [ "$avec_db" -eq 1 ] || echo "[codelab]   base de donnees : codelab update $projet"
  echo "[codelab]   projet web    : cd $DOSSIER && npm create vite@latest ."
  echo "[codelab]   puis declare-le dans le panneau (Applications > Nouvelle application)."
  echo "[codelab]   apres une mise a jour de CodeLab : codelab update $projet"

  # En dernier, volontairement : rouvrir la fenetre remplace la vue courante,
  # et les lignes ci-dessus doivent avoir ete ecrites avant.
  if [ "$ouvrir" -eq 1 ]; then
    ouvrir_dans_vscode "$DOSSIER"
  fi
}


# --------------------------------- db ---------------------------------

cmd_db() {
  [ "$#" -eq 1 ] || { usage; exit 2; }
  projet="$1"
  # Le nom sert d'identifiant SQL, de nom de compte et de nom de dossier. On
  # refuse tout de suite ce qui n'est ni l'un ni l'autre plutot que de
  # laisser Postgres renvoyer une erreur de syntaxe a rallonge.
  nom_valide "$projet" || {
    echo "codelab db: nom invalide \"$projet\" -- lettres, chiffres," \
         "tirets et soulignes, en commencant par une lettre." >&2
    exit 2
  }
  if [ "${#projet}" -gt 63 ]; then
    echo "codelab db: nom trop long (63 caracteres au plus)." >&2
    exit 2
  fi

  # Les bases de la stack ne sont pas des projets.
  case "$projet" in
    codelab | dagster | postgres | codelab_essai_restauration | "${CODELAB_INSTANCE_DB:-dagster}")
      echo "codelab db: \"$projet\" est une base de la stack CodeLab, pas un" \
           "projet -- choisis un autre nom." >&2
      exit 2 ;;
  esac

  # UNE BASE, UN COMPTE. La session n'a pas le compte administrateur de
  # Postgres : elle demande la base au gardien du poste (dev/entrypoint.sh),
  # qui la cree avec son propre compte -- seul, avec l'administrateur, a
  # pouvoir y entrer.
  DEMANDES="${CODELAB_BASES_DEMANDES:-/run/codelab-bases}"
  if [ ! -d "$DEMANDES" ] || [ ! -w "$DEMANDES" ]; then
    echo "codelab db: le gardien des bases ne repond pas ($DEMANDES absent) --" \
         "redemarre codelab-dev, ou cree la base depuis le panneau." >&2
    exit 1
  fi
  : > "$DEMANDES/$projet.demande"
  i=0
  while [ -e "$DEMANDES/$projet.demande" ] && [ "$i" -lt 120 ]; do
    sleep 0.5; i=$((i + 1))
  done
  if [ -e "$DEMANDES/$projet.demande" ]; then
    rm -f "$DEMANDES/$projet.demande"
    echo "codelab db: pas de reponse du gardien des bases en 60 s (Postgres" \
         "injoignable ?). Reessaie dans un moment." >&2
    exit 1
  fi
  if [ -f "$DEMANDES/$projet.erreur" ]; then
    echo "codelab db: $(cat "$DEMANDES/$projet.erreur")" >&2
    exit 1
  fi
  echo "[codelab] $(cat "$DEMANDES/$projet.fait" 2>/dev/null || echo "base \"$projet\" prete.")"
  echo "[codelab] dans le dossier du projet, psql et le code s'y connectent avec son compte ;"
  echo "[codelab] si le dossier porte un autre nom : CODELAB_DB=$projet dans son .env"
}

# ----------------------------- vscode-bases -----------------------------
#
# SQLTools (l'explorateur de bases de VS Code) lit ses connexions dans les
# REGLAGES, contrairement a Database Client, qui les range sur le poste de
# travail, hors de portee du serveur. On les declare donc dans les reglages
# « machine » du serveur VS Code de ce conteneur (l'onglet « Remote » des
# reglages) : ils valent pour tout dossier ouvert ici.
#
# Une connexion par base de projet, groupe « CodeLab », chacune avec SON
# compte (~/.codelab-bases, tenu par le gardien des bases) : les bases de la
# stack n'y sont pas, et aucune n'est ouverte avec le compte administrateur.
# Pas de ~/.pgpass : le terminal n'a que le compte du projet ou il se trouve
# (dev/bases-du-dossier.sh), pas ceux de tous les projets a la fois.
#
# Seul le groupe « CodeLab » est reecrit : une connexion ajoutee a la main
# reste. Un fichier de reglages avec des commentaires (JSONC) n'est pas
# touche -- on le dit, plutot que de le reecrire et perdre ce qu'il contient.
cmd_vscode_bases() {
  discret=""
  [ "${1:-}" = "--discret" ] && discret=1
  REGLAGES="${CODELAB_VSCODE_REGLAGES:-$HOME/.vscode-server/data/Machine/settings.json}"
  BASES="${CODELAB_BASES_FICHIER:-$HOME/.codelab-bases}"
  if [ ! -r "$BASES" ]; then
    [ -n "$discret" ] || echo "codelab vscode-bases: $BASES absent -- le gardien des" \
                             "bases ne l'a pas encore ecrit (Postgres injoignable ?)." >&2
    return 1
  fi
  CODELAB_DISCRET="$discret" python3 - "$REGLAGES" "$BASES" <<'PYBASES'
import json, os, sys
chemin, fichier_bases = sys.argv[1], sys.argv[2]
discret = bool(os.environ.get("CODELAB_DISCRET"))
GROUPE = "CodeLab"
hote = os.environ.get("PGHOST", "codelab-postgres")
port = int(os.environ.get("PGPORT") or 5432)
bases = []
with open(fichier_bases, encoding="utf-8") as f:
    for ligne in f:
        morceaux = ligne.split()
        if len(morceaux) == 2:
            bases.append(tuple(morceaux))

reglages = {}
if os.path.exists(chemin):
    try:
        with open(chemin, encoding="utf-8") as f:
            texte = f.read()
        reglages = json.loads(texte) if texte.strip() else {}
    except (OSError, ValueError):
        print(f"[codelab] {chemin} contient des commentaires ou n'est pas du JSON : "
              "connexions SQLTools non ecrites.", file=sys.stderr)
        sys.exit(1)
    if not isinstance(reglages, dict):
        sys.exit(1)
codelab = [{"name": b, "group": GROUPE, "driver": "PostgreSQL", "server": hote, "port": port,
            "database": b, "username": b, "password": m, "previewLimit": 50}
           for b, m in bases]
avant = reglages.get("sqltools.connections")
autres = [c for c in (avant if isinstance(avant, list) else [])
          if not (isinstance(c, dict) and c.get("group") == GROUPE)]
reglages["sqltools.connections"] = codelab + autres
if reglages.get("sqltools.connections") == avant:
    if not discret:
        print(f"[codelab] SQLTools : {len(bases)} base(s), deja a jour.")
    sys.exit(0)
os.makedirs(os.path.dirname(chemin), exist_ok=True)
tmp = chemin + ".codelab"
with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as f:
    json.dump(reglages, f, indent=2, ensure_ascii=False)
    f.write("\n")
os.chmod(tmp, 0o600)
os.replace(tmp, chemin)
print(f"[codelab] SQLTools : {len(bases)} base(s) declaree(s) dans {chemin}.")
PYBASES
}

# ------------------------------- agents -------------------------------
#
# Codex lit deux niveaux d'instructions : un fichier global dans son dossier
# de configuration ($CODEX_HOME/AGENTS.md, pose par l'entrypoint), puis le
# AGENTS.md a la racine du projet. Le niveau global n'est pas honore par
# toutes les versions de la CLI -- on recopie donc le manuel dans le projet,
# ou il est lu a coup sur.
#
# Le manuel est insere dans un bloc delimite, reecrit a chaque appel. Tout ce
# qui est ecrit HORS de ce bloc est conserve : c'est la que vivent les
# consignes propres au projet, et les relancer apres une mise a jour de la
# stack ne les efface pas.

cmd_agents() {
  [ "$#" -le 1 ] || { usage; exit 2; }

  PROJET="$(cd "${1:-.}" 2>/dev/null && pwd)" || {
    echo "codelab agents: dossier introuvable : ${1:-.}" >&2
    exit 1
  }
  [ -r "$MANUEL" ] || {
    echo "codelab agents: manuel introuvable ($MANUEL)." >&2
    exit 1
  }

  CIBLE="$PROJET/AGENTS.md"
  TMP="$CIBLE.tmp.$$"
  # Le fichier est reconstruit dans un temporaire puis deplace : une ecriture
  # interrompue ne doit pas laisser un AGENTS.md tronque derriere elle.
  trap 'rm -f "$TMP" "$TMP.merge"' EXIT

  {
    echo "$DEBUT"
    cat "$MANUEL"
    echo "$FIN"
  } > "$TMP"

  if [ -f "$CIBLE" ] && grep -qF "$DEBUT" "$CIBLE"; then
    # Bloc deja present : on ne remplace que lui, en gardant ce qu'il y a autour.
    awk -v debut="$DEBUT" -v fin="$FIN" -v bloc="$TMP" '
      $0 == debut { while ((getline ligne < bloc) > 0) print ligne; close(bloc); saut = 1; next }
      $0 == fin   { saut = 0; next }
      !saut       { print }
    ' "$CIBLE" > "$TMP.merge"
    mv "$TMP.merge" "$CIBLE"
    echo "[codelab] manuel mis a jour dans $CIBLE."
  elif [ -f "$CIBLE" ]; then
    # Fichier ecrit avant l'existence de cette commande : son contenu devient
    # la partie "projet", sous le bloc.
    { cat "$TMP"; echo; cat "$CIBLE"; } > "$TMP.merge"
    mv "$TMP.merge" "$CIBLE"
    echo "[codelab] manuel ajoute en tete de $CIBLE (contenu existant conserve)."
  else
    NOM="$(basename "$PROJET")"
    {
      cat "$TMP"
      cat <<SQUELETTE

# Projet $NOM

*A completer -- ces sections sont lues par l'agent avant chaque tache.*

## Ce que fait ce projet

## Commandes

| But | Commande |
|---|---|
| Installer | |
| Tester | |
| Construire | |
| Lancer en local | |

## Conventions propres a ce projet
SQUELETTE
    } > "$TMP.merge"
    mv "$TMP.merge" "$CIBLE"
    echo "[codelab] $CIBLE cree -- complete la section \"Projet $NOM\"."
  fi

  # Supprime ici et pas seulement par le trap : « update --tous » appelle
  # cette fonction pour chaque projet, et le trap ne voit que le dernier.
  rm -f "$TMP"
  chmod g+rw "$CIBLE" 2>/dev/null || true
  claude_md "$PROJET"
}

# Claude Code lit CLAUDE.md, pas AGENTS.md. Plutot qu'une seconde copie du
# manuel -- deux copies divergent, et c'est celle qu'on ne relit jamais qui
# se met a mentir --, un CLAUDE.md d'une ligne qui importe AGENTS.md
# (syntaxe « @fichier » de Claude Code) : les deux agents lisent alors
# exactement les memes consignes.
#
# Un CLAUDE.md deja present appartient au projet : on n'y touche pas, on
# signale seulement s'il n'importe pas AGENTS.md.
claude_md() {
  CLAUDE="$1/CLAUDE.md"
  if [ ! -e "$CLAUDE" ]; then
    cat > "$CLAUDE" <<'CLAUDE'
@AGENTS.md

<!-- Les consignes de ce projet vivent dans AGENTS.md, lu aussi par Codex.
     Ecris-les la-bas : ce fichier ne fait que l'importer pour Claude Code. -->
CLAUDE
    chmod g+rw "$CLAUDE" 2>/dev/null || true
    echo "[codelab] $CLAUDE cree (importe AGENTS.md pour Claude Code)."
  elif ! grep -q '^@AGENTS\.md' "$CLAUDE"; then
    echo "[codelab] $CLAUDE existe et n'importe pas AGENTS.md : ajoute-y" \
         "la ligne \"@AGENTS.md\" pour que Claude Code lise le manuel."
  fi
}

# ------------------------------- update -------------------------------
#
# Met un projet existant au niveau de la stack. Chaque geste est sans
# danger a rejouer, et aucun n'efface ce que le projet a ecrit lui-meme :
# le bloc du manuel est remplace, le reste de AGENTS.md garde ; un CLAUDE.md
# existant n'est pas touche ; un module modifie reste tel quel ; le
# .gitignore ne recoit que des lignes en plus ; la base n'est creee que si
# elle manque.

# Le projet du dossier courant : /workspace/<projet>/... -> /workspace/<projet>.
projet_courant() {
  case "$PWD/" in
    "$WS"/?*/*) p=${PWD#"$WS"/}; echo "$WS/${p%%/*}" ;;
    *) return 1 ;;
  esac
}

mettre_a_jour() {
  dossier="$1"; avec_db="$2"
  nom=$(basename "$dossier")
  echo "[codelab] mise a jour de $dossier"
  if [ ! -e "$dossier/.git" ]; then
    if git -C "$dossier" init -q 2>/dev/null; then
      echo "[codelab]   depot git initialise."
    fi
  fi
  completer_gitignore "$dossier"
  cmd_agents "$dossier"
  deposer_modules "$dossier" maj
  if [ "$avec_db" -eq 1 ]; then
    if nom_valide "$nom"; then
      assurer_la_base "$nom"
    else
      echo "[codelab]   pas de base : \"$nom\" n'est pas un nom de base valide" \
           "(lettres, chiffres, tirets, soulignes, une lettre en tete)."
    fi
  fi
}

cmd_update() {
  WS="${CODELAB_WORKSPACE:-/workspace}"
  cible=""; tous=0; avec_db=1
  for arg in "$@"; do
    case "$arg" in
      --tous|--all) tous=1 ;;
      --sans-db|--no-db) avec_db=0 ;;
      -*) echo "codelab update: option inconnue \"$arg\"." >&2; exit 2 ;;
      *)  [ -z "$cible" ] || { usage; exit 2; }; cible="$arg" ;;
    esac
  done

  if [ "$tous" -eq 1 ]; then
    [ -z "$cible" ] || { echo "codelab update: --tous ou un projet, pas les deux." >&2; exit 2; }
    # Seuls les dossiers qui portent deja le manuel sont des projets CodeLab :
    # /workspace contient aussi des clones et des essais qui n'en sont pas.
    n=0
    for d in "$WS"/*/; do
      d=${d%/}
      [ -f "$d/AGENTS.md" ] && grep -qF "$DEBUT" "$d/AGENTS.md" || continue
      mettre_a_jour "$d" "$avec_db"
      n=$((n + 1))
    done
    echo "[codelab] $n projet(s) mis a jour."
    return 0
  fi

  case "$cible" in
    "") dossier=$(projet_courant) || {
          echo "codelab update: lance-la depuis le dossier d'un projet, ou donne-le" \
               "(codelab update mon-projet, ou --tous)." >&2
          exit 2
        } ;;
    # Un chemin (ancienne forme de « codelab agents <dossier> ») : pris tel quel.
    */* | .*) dossier="$(cd "$cible" 2>/dev/null && pwd)" || {
          echo "codelab update: dossier introuvable : $cible" >&2
          exit 1
        } ;;
    *)  dossier="$WS/$cible" ;;
  esac
  [ -d "$dossier" ] || {
    echo "codelab update: $dossier n'existe pas -- pour le creer : codelab create $cible" >&2
    exit 1
  }
  mettre_a_jour "$dossier" "$avec_db"
}

# ------------------------------- video -------------------------------
#
# La video de presentation d'un projet, fabriquee dans le poste, sans IA :
# un navigateur joue video/scenario.mjs en filmant, la voix off est
# synthetisee en local (Piper), ffmpeg monte le tout. Le scenario, lui, est
# du code du projet : on l'ecrit, ou on demande a son agent de l'ecrire (le
# manuel AGENTS.md explique comment). Le hub montre ensuite la video sur la
# tuile de l'application.
VIDEO_OUTILS="${CODELAB_VIDEO_OUTILS:-/usr/local/share/codelab/video}"

cmd_video() {
  WS="${CODELAB_WORKSPACE:-/workspace}"
  if [ "$#" -ge 1 ]; then
    case "$1" in
      */* | "" | .*) echo "codelab video: nom de projet invalide \"$1\"." >&2; exit 2 ;;
    esac
    projet="$WS/$1"
  else
    # Sans argument : le projet du dossier courant.
    projet=$(projet_courant) || {
      echo "codelab video: donne un projet (codelab video mon-projet), ou lance-la" \
           "depuis son dossier." >&2
      exit 2
    }
  fi
  [ -d "$projet" ] || { echo "codelab video: $projet n'existe pas." >&2; exit 1; }
  nom=$(basename "$projet")
  if [ ! -f "$projet/video/scenario.mjs" ]; then
    mkdir -p "$projet/video"
    sed -e "s/__TITRE__/$nom/g" -e "s#__ADRESSE__#${CODELAB_VIDEO_ADRESSE:-http://codelab-app-manager:9002}/$nom/#g" \
        "$VIDEO_OUTILS/scenario-modele.mjs" > "$projet/video/scenario.mjs"
    echo "[codelab] $projet/video/scenario.mjs cree : decris-y ce que la video montre"
    echo "[codelab] (ou demande-le a ton agent), puis relance « codelab video $nom »."
    return 0
  fi
  echo "[codelab] video de $nom : tournage et montage (une a deux minutes)..."
  # Chromium est installe dans l'image, a cote de Playwright. Le Dockerfile
  # le dit par « ENV PLAYWRIGHT_BROWSERS_PATH », mais une session SSH (et
  # donc le terminal de VS Code) ne recoit pas l'environnement du conteneur.
  # Vecu : Playwright cherchait alors Chromium dans ~/.cache/ms-playwright
  # et demandait « npx playwright install ». Le chemin se pose donc ici.
  PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-$VIDEO_OUTILS/navigateurs}" \
    node "$VIDEO_OUTILS/fabriquer.mjs" "$projet"
}

# ------------------------------ dispatch ------------------------------

case "${1:-}" in
  create)       shift; cmd_create "$@" ;;
  update)       shift; cmd_update "$@" ;;
  video)        shift; cmd_video "$@" ;;
  help|-h|--help|"") aide "${2:-}" ;;
  db)           shift; cmd_db "$@" ;;
  vscode-bases) shift; cmd_vscode_bases "$@" ;;
  # Anciens noms. new garde ses options (--db, --ouvrir) ; agents ne fait
  # que le manuel et CLAUDE.md, comme avant. Les taches VS Code deja copiees
  # dans /workspace les appellent encore : ils restent tant que des
  # installations ont ces taches -- le squelette du jour appelle create et
  # update.
  new)          shift; cmd_create "$@" ;;
  agents)       shift; cmd_agents "$@" ;;
  *)
    echo "codelab: commande inconnue \"$1\"." >&2
    usage
    exit 2 ;;
esac
