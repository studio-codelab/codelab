#!/bin/sh
# codelab -- outil de projet du conteneur codelab-dev.
#
#   codelab new <nom>         cree un projet pret a travailler
#     ... --ouvrir             et rouvre la fenetre VS Code dessus
#   codelab db <nom>          cree la base du projet et son schema "dagster"
#   codelab agents [dossier]  ecrit le manuel CodeLab dans le AGENTS.md du projet
#                             (et un CLAUDE.md qui l'importe, pour Claude Code)
#   codelab vscode-bases      declare chaque base du serveur dans SQLTools (VS Code)
#
# Une seule commande pour tout ce qui touche a un projet, plutot qu'un
# executable par geste : la liste des sous-commandes se decouvre avec
# "codelab" seul, et il n'y a qu'un nom a retenir.
set -eu

MANUEL="${CODELAB_AGENTS_SOURCE:-/usr/local/share/codelab/AGENTS.md}"
# Les modules deposes dans chaque nouveau projet, en Python et en Node :
# « se connecter avec CodeLab » (codelab_auth), pour que l'identite soit
# prete des la premiere seconde, comme la base de donnees ; et les pages
# d'erreur et en-tetes de securite (codelab_web).
MODELES="${CODELAB_MODELES:-/usr/local/share/codelab/modeles}"
DEBUT='<!-- codelab:debut -- bloc gere par "codelab agents", ne pas editer a la main -->'
FIN='<!-- codelab:fin -->'

usage() {
  cat >&2 <<'AIDE'
usage: codelab <commande> [argument]

  new <nom> [--db]    cree le projet : dossier, git, .gitignore, AGENTS.md,
                      CLAUDE.md
       [--ouvrir]     (--db cree aussi sa base de donnees ; --ouvrir rouvre la
                      fenetre VS Code sur le nouveau projet)
  db <nom>            cree la base "<nom>" et son schema "dagster" (idempotent)
  agents [dossier]    ecrit le manuel CodeLab dans le AGENTS.md du projet,
                      et un CLAUDE.md qui l'importe (defaut : le dossier courant)
  vscode-bases        declare chaque base du serveur dans SQLTools (VS Code) :
                      rien a creer a la main, meme pour un nouveau projet
AIDE
}

# --------------------------------- new ---------------------------------
#
# Tout ce qui est propre a CodeLab dans la creation d'un projet, en une
# commande : le dossier, le depot git, le .gitignore, et le AGENTS.md que
# l'agent lira. Volontairement PAS d'echafaudage de framework -- "npm create
# vite" telecharge, pose des questions et evolue a son rythme ; le reproduire
# ici vieillirait mal. La commande l'affiche en piste suivante, c'est tout.

# Rouvre la fenetre VS Code sur un dossier -- quand il y en a une.
#
# COMMENT CELA MARCHE. La fenetre VS Code qui tourne sur le poste de travail
# expose une socket a l'interieur du conteneur ; son chemin arrive dans
# VSCODE_IPC_HOOK_CLI. Le petit executable "code" pose par le serveur
# distant (son "remote-cli") parle a la fenetre a travers cette socket.
#
# Deux conditions, donc, et aucune n'est garantie : la variable, qui manque
# des qu'on est dans une session SSH ordinaire, et l'executable, dont le
# chemin contient l'empreinte de la version du serveur.
#
# RIEN ICI NE DOIT FAIRE ECHOUER LA COMMANDE. Le projet est deja cree quand
# on arrive : ouvrir la fenetre est un confort. Un echec se raconte, il ne
# se propage pas -- sinon "codelab new" sortirait en erreur sur un projet
# parfaitement valide, et la prochaine fois on ne saurait plus si le projet
# a ete cree ou non.
ouvrir_dans_vscode() {
  dossier="$1"

  if [ -z "${VSCODE_IPC_HOOK_CLI:-}" ]; then
    echo "[codelab]   aucune fenetre VS Code a rouvrir (session SSH simple)."
    return 0
  fi

  outil="$(command -v code 2>/dev/null || true)"
  if [ -z "$outil" ] || [ ! -x "$outil" ]; then
    # Le serveur distant s'installe sous un dossier portant l'empreinte de
    # sa version. On prend le plus recent plutot que d'en figer une : elle
    # change a chaque mise a jour de VS Code.
    outil=""
    for candidat in $(ls -1dt "$HOME"/.vscode-server/bin/*/bin/remote-cli/code 2>/dev/null); do
      if [ -x "$candidat" ]; then outil="$candidat"; break; fi
    done
  fi

  if [ -z "$outil" ]; then
    echo "[codelab]   VS Code est la, mais son outil \"code\" reste introuvable :"
    echo "[codelab]   ouvre le dossier a la main ($dossier)."
    return 0
  fi

  echo "[codelab]   ouverture de la fenetre sur $dossier"
  "$outil" --reuse-window "$dossier" || {
    echo "[codelab]   VS Code n'a pas repondu : ouvre le dossier a la main."
    return 0
  }
}


cmd_new() {
  projet=""
  avec_db=0
  ouvrir=0
  for arg in "$@"; do
    case "$arg" in
      --db) avec_db=1 ;;
      --ouvrir) ouvrir=1 ;;
      -*)   echo "codelab new: option inconnue \"$arg\"." >&2; exit 2 ;;
      *)    [ -z "$projet" ] || { usage; exit 2; }; projet="$arg" ;;
    esac
  done
  [ -n "$projet" ] || { usage; exit 2; }

  # Meme regle de nommage que pour la base : le nom sert de dossier, d'adresse
  # web sous le panneau, et eventuellement d'identifiant SQL.
  case "$projet" in
    *[!a-zA-Z0-9_-]* | "" | [!a-zA-Z]*)
      echo "codelab new: nom invalide \"$projet\" -- lettres, chiffres," \
           "tirets et soulignes, en commencant par une lettre." >&2
      exit 2 ;;
  esac

  RACINE="${CODELAB_WORKSPACE:-/workspace}"
  DOSSIER="$RACINE/$projet"
  # Jamais par-dessus un dossier existant : la commande doit rester sans
  # danger a lancer deux fois par erreur.
  [ ! -e "$DOSSIER" ] || {
    echo "codelab new: $DOSSIER existe deja." >&2
    exit 1
  }

  mkdir -p "$DOSSIER"
  cd "$DOSSIER"

  git init -q 2>/dev/null || echo "[codelab] git indisponible : depot non initialise."

  # .env en tete : /workspace n'est pas chiffre, et un secret pousse sur un
  # depot distant ne se rattrape pas.
  cat > .gitignore <<'IGNORE'
.env
node_modules/
vendor/
.dagster-venv/
dist/
build/
__pycache__/
IGNORE

  cat > README.md <<README
# $projet

*A completer : ce que fait ce projet, et comment le lancer.*
README

  cmd_agents "$DOSSIER" >/dev/null
  for modele in codelab_auth.py codelab-auth.js codelab_web.py codelab-web.js; do
    if [ -f "$MODELES/$modele" ]; then
      cp "$MODELES/$modele" "$DOSSIER/$modele"
    fi
  done
  # Un "[ ... ] && cmd" ici sortirait du script sous "set -e" quand le test
  # echoue : la forme longue evite ce piege classique.
  if [ "$avec_db" -eq 1 ]; then
    cmd_db "$projet"
  fi

  echo "[codelab] projet cree : $DOSSIER"
  echo "[codelab]   AGENTS.md pose -- complete la section \"Projet $projet\""
  echo "[codelab]   connexion CodeLab : codelab_auth.py / codelab-auth.js (voir leur en-tete)"
  echo "[codelab]   erreurs et en-tetes : codelab_web.py / codelab-web.js"
  [ "$avec_db" -eq 1 ] || echo "[codelab]   base de donnees : codelab db $projet"
  echo "[codelab]   projet web    : cd $DOSSIER && npm create vite@latest ."
  echo "[codelab]   puis declare-le dans le panneau (port 9001)."

  # En dernier, volontairement : rouvrir la fenetre remplace la vue courante,
  # et les lignes ci-dessus doivent avoir ete ecrites avant.
  if [ "$ouvrir" -eq 1 ]; then
    ouvrir_dans_vscode "$DOSSIER"
  fi
}


# --------------------------------- db ---------------------------------

# La connexion Postgres de la stack : hote, port, compte, et le mot de passe
# lu dans credentials.env quand la session ne l'a pas deja.
pg_env() {
  ENV_FILE="${CODELAB_ENV_FILE:-/var/lib/codelab/config/credentials.env}"
  # Base de maintenance : on ne peut pas creer une base depuis elle-meme, il
  # faut etre connecte ailleurs. La base d'instance de Dagster existe
  # toujours, c'est le point d'entree naturel.
  ADMIN_DB="${CODELAB_INSTANCE_DB:-dagster}"
  PGHOST="${PGHOST:-codelab-postgres}"
  PGPORT="${PGPORT:-5432}"
  PGUSER="${PGUSER:-codelab}"
  export PGHOST PGPORT PGUSER
  if [ -z "${PGPASSWORD:-}" ] && [ -r "$ENV_FILE" ]; then
    # tail : la derniere occurrence fait autorite (bloc reecrit en fin de fichier).
    PGPASSWORD="$(sed -n 's/^POSTGRES_PASSWORD=//p' "$ENV_FILE" | tail -n 1)"
    export PGPASSWORD
  fi
}

cmd_db() {
  [ "$#" -eq 1 ] || { usage; exit 2; }
  projet="$1"
  # Le nom sert d'identifiant SQL et de nom de dossier. On refuse tout de
  # suite ce qui n'est ni l'un ni l'autre plutot que de laisser Postgres
  # renvoyer une erreur de syntaxe a rallonge sur un nom a espaces ou a
  # guillemets.
  case "$projet" in
    *[!a-zA-Z0-9_-]* | "" | [!a-zA-Z]*)
      echo "codelab db: nom invalide \"$projet\" -- lettres, chiffres," \
           "tirets et soulignes, en commencant par une lettre." >&2
      exit 2 ;;
  esac

  # Les bases de la stack ne sont pas des projets : leur poser le schema
  # « dagster » en tete du search_path detournerait leurs tables.
  case "$projet" in
    codelab | dagster | postgres | "${CODELAB_INSTANCE_DB:-dagster}")
      echo "codelab db: \"$projet\" est une base de la stack CodeLab, pas un" \
           "projet -- choisis un autre nom." >&2
      exit 2 ;;
  esac

  pg_env
  SCHEMA="${CODELAB_PROJECT_SCHEMA:-dagster}"

  if [ "$(psql -d "$ADMIN_DB" -tAc \
          "SELECT 1 FROM pg_database WHERE datname='$projet'")" = "1" ]; then
    echo "[codelab] base \"$projet\" deja presente."
  else
    # CREATE DATABASE n'accepte pas IF NOT EXISTS, d'ou le test ci-dessus.
    psql -d "$ADMIN_DB" -c "CREATE DATABASE \"$projet\"" >/dev/null
    echo "[codelab] base \"$projet\" creee."
  fi

  # ALTER ROLE ... IN DATABASE est ce qui fait qu'un "CREATE TABLE ma_table"
  # dans un asset atterrit dans le schema du projet, sans prefixe dans le code.
  psql -d "$projet" >/dev/null <<SQL
CREATE SCHEMA IF NOT EXISTS "$SCHEMA";
ALTER ROLE "$PGUSER" IN DATABASE "$projet" SET search_path TO "$SCHEMA", public;
SQL
  echo "[codelab] schema \"$SCHEMA\" et search_path en place sur \"$projet\"."
  echo "[codelab] dans le .env du projet : CODELAB_DB=$projet"
  # La nouvelle base apparait aussitot dans SQLTools. Un confort : un echec
  # ne fait pas echouer la creation.
  cmd_vscode_bases --discret || true
}

# ----------------------------- vscode-bases -----------------------------
#
# SQLTools (l'explorateur de bases de VS Code) lit ses connexions dans les
# REGLAGES, contrairement a Database Client, qui les range sur le poste de
# travail, hors de portee du serveur. On les declare donc dans les reglages
# « machine » du serveur VS Code de ce conteneur (l'onglet « Remote » des
# reglages) : ils valent pour tout dossier ouvert ici, donc pour chaque
# projet, sans rien creer a la main.
#
# Une connexion par base du serveur, rangees dans le groupe « CodeLab ».
# Seul ce groupe est reecrit : une connexion ajoutee a la main reste. Un
# fichier de reglages avec des commentaires (JSONC) n'est pas touche -- on
# le dit, plutot que de le reecrire et perdre ce qu'il contient.
cmd_vscode_bases() {
  discret=""
  [ "${1:-}" = "--discret" ] && discret=1
  pg_env
  REGLAGES="${CODELAB_VSCODE_REGLAGES:-$HOME/.vscode-server/data/Machine/settings.json}"
  if ! bases="$(psql -d "$ADMIN_DB" -tAc "SELECT datname FROM pg_database
        WHERE NOT datistemplate AND datname <> 'postgres' ORDER BY datname" 2>/dev/null)"; then
    [ -n "$discret" ] || echo "codelab vscode-bases: Postgres injoignable." >&2
    return 1
  fi
  CODELAB_BASES="$bases" CODELAB_DISCRET="$discret" python3 - "$REGLAGES" <<'PYBASES'
import json, os, sys
chemin = sys.argv[1]
discret = bool(os.environ.get("CODELAB_DISCRET"))
GROUPE = "CodeLab"
reglages = {}
if os.path.exists(chemin):
    try:
        with open(chemin, encoding="utf-8") as f:
            texte = f.read()
        reglages = json.loads(texte) if texte.strip() else {}
    except (OSError, ValueError):
        print(f"[codelab] {chemin} contient des commentaires ou n'est pas du JSON : "
              "connexions SQLTools non ecrites.", file=sys.stderr)
        sys.exit(1)
    if not isinstance(reglages, dict):
        sys.exit(1)
bases = [b for b in os.environ.get("CODELAB_BASES", "").split() if b]
port = int(os.environ.get("PGPORT") or 5432)
codelab = [{"name": b, "group": GROUPE, "driver": "PostgreSQL",
            "server": os.environ.get("PGHOST", "codelab-postgres"), "port": port,
            "database": b, "username": os.environ.get("PGUSER", "codelab"),
            "password": os.environ.get("PGPASSWORD", ""), "previewLimit": 50}
           for b in bases]
avant = reglages.get("sqltools.connections")
autres = [c for c in (avant if isinstance(avant, list) else [])
          if not (isinstance(c, dict) and c.get("group") == GROUPE)]
reglages["sqltools.connections"] = codelab + autres
if reglages.get("sqltools.connections") == avant:
    if not discret:
        print(f"[codelab] SQLTools : {len(bases)} base(s), deja a jour.")
    sys.exit(0)
os.makedirs(os.path.dirname(chemin), exist_ok=True)
temporaire = chemin + ".codelab"
with open(temporaire, "w", encoding="utf-8") as f:
    json.dump(reglages, f, indent=2, ensure_ascii=False)
    f.write("\n")
# Le mot de passe y figure, comme dans PGPASSWORD : lisible du seul compte.
os.chmod(temporaire, 0o600)
os.replace(temporaire, chemin)
print(f"[codelab] SQLTools : {len(bases)} base(s) declaree(s) dans {chemin}.")
PYBASES
}

# ------------------------------- agents -------------------------------
#
# Codex lit deux niveaux d'instructions : un fichier global dans son dossier
# de configuration ($CODEX_HOME/AGENTS.md, pose par l'entrypoint), puis le
# AGENTS.md a la racine du projet. Le niveau global n'est pas honore par
# toutes les versions de la CLI -- on recopie donc le manuel dans le projet,
# ou il est lu a coup sur.
#
# Le manuel est insere dans un bloc delimite, reecrit a chaque appel. Tout ce
# qui est ecrit HORS de ce bloc est conserve : c'est la que vivent les
# consignes propres au projet, et les relancer apres une mise a jour de la
# stack ne les efface pas.

cmd_agents() {
  [ "$#" -le 1 ] || { usage; exit 2; }

  PROJET="$(cd "${1:-.}" 2>/dev/null && pwd)" || {
    echo "codelab agents: dossier introuvable : ${1:-.}" >&2
    exit 1
  }
  [ -r "$MANUEL" ] || {
    echo "codelab agents: manuel introuvable ($MANUEL)." >&2
    exit 1
  }

  CIBLE="$PROJET/AGENTS.md"
  TMP="$CIBLE.tmp.$$"
  # Le fichier est reconstruit dans un temporaire puis deplace : une ecriture
  # interrompue ne doit pas laisser un AGENTS.md tronque derriere elle.
  trap 'rm -f "$TMP" "$TMP.merge"' EXIT

  {
    echo "$DEBUT"
    cat "$MANUEL"
    echo "$FIN"
  } > "$TMP"

  if [ -f "$CIBLE" ] && grep -qF "$DEBUT" "$CIBLE"; then
    # Bloc deja present : on ne remplace que lui, en gardant ce qu'il y a autour.
    awk -v debut="$DEBUT" -v fin="$FIN" -v bloc="$TMP" '
      $0 == debut { while ((getline ligne < bloc) > 0) print ligne; close(bloc); saut = 1; next }
      $0 == fin   { saut = 0; next }
      !saut       { print }
    ' "$CIBLE" > "$TMP.merge"
    mv "$TMP.merge" "$CIBLE"
    echo "[codelab] manuel mis a jour dans $CIBLE."
  elif [ -f "$CIBLE" ]; then
    # Fichier ecrit avant l'existence de cette commande : son contenu devient
    # la partie "projet", sous le bloc.
    { cat "$TMP"; echo; cat "$CIBLE"; } > "$TMP.merge"
    mv "$TMP.merge" "$CIBLE"
    echo "[codelab] manuel ajoute en tete de $CIBLE (contenu existant conserve)."
  else
    NOM="$(basename "$PROJET")"
    {
      cat "$TMP"
      cat <<SQUELETTE

# Projet $NOM

*A completer -- ces sections sont lues par l'agent avant chaque tache.*

## Ce que fait ce projet

## Commandes

| But | Commande |
|---|---|
| Installer | |
| Tester | |
| Construire | |
| Lancer en local | |

## Conventions propres a ce projet
SQUELETTE
    } > "$TMP.merge"
    mv "$TMP.merge" "$CIBLE"
    echo "[codelab] $CIBLE cree -- complete la section \"Projet $NOM\"."
  fi

  chmod g+rw "$CIBLE" 2>/dev/null || true
  claude_md "$PROJET"
}

# Claude Code lit CLAUDE.md, pas AGENTS.md. Plutot qu'une seconde copie du
# manuel -- deux copies divergent, et c'est celle qu'on ne relit jamais qui
# se met a mentir --, un CLAUDE.md d'une ligne qui importe AGENTS.md
# (syntaxe « @fichier » de Claude Code) : les deux agents lisent alors
# exactement les memes consignes.
#
# Un CLAUDE.md deja present appartient au projet : on n'y touche pas, on
# signale seulement s'il n'importe pas AGENTS.md.
claude_md() {
  CLAUDE="$1/CLAUDE.md"
  if [ ! -e "$CLAUDE" ]; then
    cat > "$CLAUDE" <<'CLAUDE'
@AGENTS.md

<!-- Les consignes de ce projet vivent dans AGENTS.md, lu aussi par Codex.
     Ecris-les la-bas : ce fichier ne fait que l'importer pour Claude Code. -->
CLAUDE
    chmod g+rw "$CLAUDE" 2>/dev/null || true
    echo "[codelab] $CLAUDE cree (importe AGENTS.md pour Claude Code)."
  elif ! grep -q '^@AGENTS\.md' "$CLAUDE"; then
    echo "[codelab] $CLAUDE existe et n'importe pas AGENTS.md : ajoute-y" \
         "la ligne \"@AGENTS.md\" pour que Claude Code lise le manuel."
  fi
}

# ------------------------------ dispatch ------------------------------

case "${1:-}" in
  new)         shift; cmd_new "$@" ;;
  db)          shift; cmd_db "$@" ;;
  agents)      shift; cmd_agents "$@" ;;
  vscode-bases) shift; cmd_vscode_bases "$@" ;;
  -h|--help|help|"") usage; [ "${1:-}" = "" ] && exit 2 || exit 0 ;;
  *)
    echo "codelab: commande inconnue \"$1\"." >&2
    usage
    exit 2 ;;
esac
